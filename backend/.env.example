# Environment Variables for GD Simulator Backend

# =============================================
# GEMINI API CONFIGURATION
# =============================================
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (flash is fast + free tier)
GEMINI_MODEL=gemini-1.5-flash

# =============================================
# SERVER CONFIGURATION
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
# JWT AUTHENTICATION
# =============================================
# Change this to a long random string in production!
JWT_SECRET=gd_simulator_super_secret_jwt_key_2024
JWT_EXPIRES_IN=7d

# =============================================
# DATABASE
# =============================================
# SQLite database file path (relative to backend/)
DB_PATH=./gd_simulator.db
