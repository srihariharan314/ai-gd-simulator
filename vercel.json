{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/gd/join/:code",
      "destination": "/frontend/human-room.html?action=join&roomCode=:code"
    },
    {
      "source": "/join/:code",
      "destination": "/frontend/human-room.html?action=join&roomCode=:code"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
